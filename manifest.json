{
  "manifest_version": 3,
  "name": "Cinema Tools for YouTube",
  "short_name": "Cinema Tools",
  "version": "1.3.0",
  "minimum_chrome_version": "116",
  "description": "Xoay, lật video YouTube, tắt đèn có đèn nền. Cửa sổ nổi cho video, chỉnh âm lượng từng tab, tải video / âm thanh / ảnh trên mọi trang.",
  "permissions": ["storage", "downloads", "nativeMessaging", "scripting", "offscreen", "webRequest", "cookies", "tabCapture", "activeTab"],
  "commands": {
    "toggle-pip": {
      "suggested_key": { "default": "Alt+P" },
      "description": "Mở / đóng cửa sổ nổi cho video của tab đang xem"
    },
    "capture-page": {
      "suggested_key": { "default": "Alt+S" },
      "description": "Chụp cả trang đang xem"
    }
  },
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "src/background/background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Cinema Tools",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": [
        "src/shared/shared.js",
        "src/page/agent.js",
        "src/page/pip.js",
        "src/content/core.js",
        "src/content/transform.js",
        "src/content/zoom.js",
        "src/content/lights.js",
        "src/content/ambient.js",
        "src/content/cinema.js",
        "src/content/download.js",
        "src/content/floating.js",
        "src/content/ui.js",
        "src/content/shortcuts.js",
        "src/content/main.js"
      ],
      "css": ["src/content/content.css"],
      "run_at": "document_idle"
    }
  ]
}
